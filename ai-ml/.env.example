# TruthLens AI/ML Service — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env — it is in .gitignore.
# NO SECRETS OR API KEYS BELONG IN THIS FILE.

# FastAPI server settings
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Storage directory for generated heatmap PNG files
# For local dev: a path on disk. For production: mount a shared volume or S3/MinIO path.
STORAGE_DIR=./storage

# Model directory — place PyTorch .pt / .pth checkpoint files here
MODEL_DIR=./models

# Name of the timm backbone architecture (blueprint: PyTorch 2.2 + timm)
# Must be a valid timm model name.  efficientnet_b0 is the default.
CLASSIFIER_BACKBONE=efficientnet_b0

# Classifier checkpoint filename (relative to MODEL_DIR).
# Leave blank to use a pretrained ImageNet backbone with an untrained binary head.
CLASSIFIER_CHECKPOINT=

# ELA re-compression quality (1–95). Lower = more sensitive heatmap.
ELA_QUALITY=90

# Image resize dimension for model input (square)
MODEL_INPUT_SIZE=224
